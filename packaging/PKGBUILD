# Build from the archive created by `make tarball` in the project root.
#   make tarball && cp clean-0.1.0.tar.gz packaging/ && cd packaging && makepkg -si
pkgname=clean-mail
pkgver=0.1.0
pkgrel=1
pkgdesc="A calm, native mail client for Omarchy"
arch=('x86_64')
url="https://gpui-kit.com"
license=('MIT')
depends=(
  'wayland' 'libxkbcommon' 'fontconfig' 'freetype2'
  'vulkan-icd-loader' 'openssl' 'zstd' 'alsa-lib'
  'webkit2gtk-4.1' 'hicolor-icon-theme'
)
makedepends=('base-devel' 'clang' 'cmake' 'pkgconf' 'rust' 'cargo')
source=("clean-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/clean-$pkgver"
  # makepkg's hardening flags (notably -fno-plt) break ring's bundled
  # assembly. Use plain optimised flags for Rust/C dependencies.
  export CFLAGS="-O2 -pipe"
  export CXXFLAGS="-O2 -pipe"
  unset LDFLAGS
  CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-8}" cargo build --release --locked
}

package() {
  cd "$srcdir/clean-$pkgver"
  install -Dm755 target/release/clean "$pkgdir/usr/bin/clean"
  install -Dm644 clean.desktop "$pkgdir/usr/share/applications/clean.desktop"
  for size in 48 64 128 256; do
    install -Dm644 "assets/icons/hicolor/${size}x${size}/apps/clean.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/clean.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
